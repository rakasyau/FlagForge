# =======================================================
# FlagForge Environment Configuration Template
# Copy this file to .env and fill in your credentials
# =======================================================

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flagforge?retryWrites=true&w=majority

# JWT Secret Key for User Session Tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Backend API Server Port
PORT=5000
